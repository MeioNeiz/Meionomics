--- NEW
local private = {
	confirmationVisible = false,
}
-- LOCAL FIX: lets overlays (Meionomics price history) follow the selected auction's item
TSMLocalAuctionSelect = TSMLocalAuctionSelect or { callbacks = {} }
function private.LocalSelect(state, selection)
	local base = state.auctionScrollTable and state.auctionScrollTable:GetBaseElement()
	local frame = base and base:_GetBaseFrame()
	local itemString = selection and selection:GetBaseItemString()
	for _, func in ipairs(TSMLocalAuctionSelect.callbacks) do
		xpcall(func, geterrorhandler(), itemString, frame)
	end
end
=== END

